{
  "version": 2,
  "installCommand": "npm install && npm --prefix apps/api install && npm --prefix apps/mobile install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/mobile/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
