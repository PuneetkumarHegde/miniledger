{
  "name": "miniledger",
  "version": "1.0.0",
  "private": true,
  "description": "MiniLedger — Full-Stack Friend Loan Tracker",
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "dev:web": "npm --prefix apps/mobile run web",
    "dev:android": "npm --prefix apps/mobile run android",
    "dev:ios": "npm --prefix apps/mobile run ios",
    "test": "npm --prefix apps/api test",
    "build:api": "npm --prefix apps/api run build",
    "prisma:migrate": "npm --prefix apps/api run prisma:migrate",
    "prisma:deploy": "npm --prefix apps/api run prisma:deploy",
    "prisma:studio": "npm --prefix apps/api run prisma:studio",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "build:vercel": "npm run prisma:generate && npm --prefix apps/mobile run build:web",
    "vercel-build": "npm run prisma:generate && npm --prefix apps/mobile run build:web"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.1",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "miniledger",
    "react-native",
    "expo",
    "express",
    "typescript",
    "prisma",
    "postgresql"
  ],
  "author": "Puneet Kumar",
  "license": "MIT"
}
